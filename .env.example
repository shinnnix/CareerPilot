# Copy this file to apps/api/.env for local backend development.
CAREERPILOT_ENVIRONMENT=development
CAREERPILOT_DEBUG=false
CAREERPILOT_DATABASE_URL=postgresql+psycopg://careerpilot:careerpilot@localhost:5432/careerpilot
CAREERPILOT_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CAREERPILOT_EMBEDDING_PROVIDER=deterministic
CAREERPILOT_EMBEDDING_MODEL=careerpilot-hash-1024-v1
CAREERPILOT_RERANKER_PROVIDER=deterministic
CAREERPILOT_RERANKER_MODEL=careerpilot-overlap-reranker-v1
CAREERPILOT_AUTH_SECRET=replace-with-at-least-32-random-characters
CAREERPILOT_ACCESS_TOKEN_TTL_MINUTES=60
CAREERPILOT_ALLOW_DEMO_AUTH=true
CAREERPILOT_DEMO_USER_ID=demo-user
CAREERPILOT_RATE_LIMIT_PER_MINUTE=120
CAREERPILOT_AUTH_RATE_LIMIT_PER_MINUTE=10
CAREERPILOT_TRUSTED_PROXY_HEADERS=false

# The Vue development server proxies /api to http://127.0.0.1:8000 by default.
# Set this only when the API is served from another origin.
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
# VITE_ALLOW_DEMO_AUTH=true
