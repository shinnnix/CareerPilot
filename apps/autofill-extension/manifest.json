{
  "manifest_version": 3,
  "name": "CareerPilot Autofill",
  "version": "0.2.0",
  "description": "Review-first CareerPilot application form autofill.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost:8080/*",
      "http://127.0.0.1:8080/*",
      "http://localhost:5173/*",
      "http://127.0.0.1:5173/*"
    ]
  },
  "action": {
    "default_title": "CareerPilot Autofill",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
