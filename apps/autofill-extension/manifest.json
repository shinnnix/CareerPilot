{
  "manifest_version": 3,
  "name": "CareerPilot Autofill",
  "version": "0.1.0",
  "description": "Review-first CareerPilot application form autofill.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "CareerPilot Autofill",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
