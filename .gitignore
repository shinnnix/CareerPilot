# ==============================================================================
# CareerPilot .gitignore
#
# 原则：源码 / 文档 / 合成数据集（datasets/）可以提交；
#       凡是"本机跑起来之后才产生"的东西 —— 凭据、数据库、上传的简历、
#       日志、AI 工具会话记忆 —— 一律不进仓库。
#
# 如果某个文件确实需要提交但被规则拦住了，用强制添加：
#   git add -f path/to/file
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 凭据与本地配置（最高优先级，一旦泄露等同事故）
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local
*.local.*
.envrc
.netrc
.npmrc
.pypirc

# 密钥 / 证书 / 服务账号
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
id_ecdsa*
credentials.json
service-account*.json
secrets.yaml
secrets.yml

# ------------------------------------------------------------------------------
# 2. 数据库与运行时状态（含真实用户、投递记录、简历正文）
# ------------------------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-journal
pgdata/
redis-data/

# ------------------------------------------------------------------------------
# 3. 上传文件 / 用户材料 / 本地数据目录
#    datasets/ 里的检索语料是合成数据，可以提交；真实数据请放 private 子目录
# ------------------------------------------------------------------------------
data/
uploads/
storage/
apps/api/uploads/
apps/api/storage/
apps/api/media/
datasets/private/

# ------------------------------------------------------------------------------
# 4. 个人简历与投递材料（PDF/Word/表格/截图都可能带手机号、身份证、住址）
#    仓库当前不含任何此类二进制资源，如需提交示例文件请用 git add -f
# ------------------------------------------------------------------------------
*.pdf
*.doc
*.docx
*.xls
*.xlsx
*.csv
*.zip
*.7z
*.rar
个人简历*
简历*
resume-*
resume_*

# docs/ 下的 md 全部是本地设计文档、架构深度解析、面试问答库与学习指南，
# 属于个人求职准备材料，只保留在本机，不随仓库公开。
# 需要提交某篇文档时用：git add -f docs/xxx.md
docs/*.md
docs/**/*.md

# 个人面试/求职复盘材料（历史遗留文件，保留忽略）
agent.md
AI_INTERNSHIP_AGENT_ARCHITECTURE.md
INTERNSHIP_RESUME_PROJECT_DESCRIPTION.md
agent_guide_render/
build_agent_interview_guide.py

# ------------------------------------------------------------------------------
# 5. AI / 编辑器工具的本地状态与会话记忆
#    .workbuddy-ai/memory 记录的是本机对话与决策笔记，属于个人上下文
# ------------------------------------------------------------------------------
.workbuddy-ai/
.codex/
.agents/
.claude/
.cursor/
.aider*
.idea/
.vscode/

# ------------------------------------------------------------------------------
# 6. Python
# ------------------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# ------------------------------------------------------------------------------
# 7. Node / 前端构建产物
# ------------------------------------------------------------------------------
node_modules/
dist/
build/
.vite/
*.tsbuildinfo
.npm-cache/
.pnpm-store/
.yarn/
coverage/
.nyc_output/
playwright-report/
test-results/
.docker-config/

# ------------------------------------------------------------------------------
# 8. 本地模型权重（体积大且可能含私有微调结果）
# ------------------------------------------------------------------------------
models/

# ------------------------------------------------------------------------------
# 9. 日志、临时文件、备份
# ------------------------------------------------------------------------------
*.log
*.log.*
logs/
.tmp_*/
.tmp_*
*.tmp
*.bak
*.orig
*.rej
*.swp
*~

# ------------------------------------------------------------------------------
# 10. 操作系统
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
